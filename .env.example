# Copy to .env next to docker-compose.yml before: docker compose up -d --build
# Required: 32+ character secret (not the old local-dev default)

JWT_SECRET=change-me-to-a-long-random-secret-32chars-min

# Browser origin users open (LAN example: http://192.168.1.50:5180)
CORS_ORIGIN=http://localhost:5180

# Keep false until you terminate TLS in front of the stack
COOKIE_SECURE=false

IRPPMS_WEB_PORT=5180
IRPPMS_API_PORT=4100
